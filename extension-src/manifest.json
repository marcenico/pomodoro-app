{
  "manifest_version": 3,
  "name": "The Pomodoro Technique",
  "description": "Timer to apply the Pomodoro Technique. Focus sessions, short and long breaks.",
  "version": "1.0.0",
  "permissions": ["alarms", "notifications", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
